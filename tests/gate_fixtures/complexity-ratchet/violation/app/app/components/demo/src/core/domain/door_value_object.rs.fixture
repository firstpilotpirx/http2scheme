//! A door.

/// A door number.
pub struct DoorValueObject(u16);

impl DoorValueObject {
    /// The number.
    pub fn number(&self) -> u16 {
        if self.0 > 10 { self.0 } else if self.0 > 5 { 1 } else if self.0 > 2 { 2 } else { 0 }
    }
}

